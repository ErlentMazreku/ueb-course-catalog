# Kopjoje këtë skedar si .env dhe plotëso vlerat.
# .env nuk shkon në GitHub, sepse ka fjalëkalime.

# Fjalëkalimi i përdoruesit "katalog" të databazës PostgreSQL (i njëjti si te docker run)
DB_PASSWORD=

# Fjalëkalimi i përdoruesit "user" të aplikacionit (roli USER, përdoret nga pjesa 4)
USER_PASSWORD=

# Fjalëkalimi i përdoruesit "admin" të aplikacionit (rolet ADMIN dhe USER, përdoret nga pjesa 4)
ADMIN_PASSWORD=